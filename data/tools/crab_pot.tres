[gd_resource type="Resource" script_class="ToolDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/resources/tool_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/tools/set_pot_action.gd" id="2_action"]
[ext_resource type="Texture2D" path="res://assets/sprites/items/crab_pot.png" id="3_icon"]

[sub_resource type="Resource" id="Resource_action"]
script = ExtResource("2_action")

[resource]
script = ExtResource("1_def")
id = &"crab_pot"
display_name = "Crab pot"
description = "A willow-and-net pot on a rope with a float. Face the sea beside the Cove's pier and Space to lower it. Baited (bait, winkles, mussels or shrimps), it fills overnight: E on it the next day to haul it up."
icon = ExtResource("3_icon")
energy_cost = 1.0
action = SubResource("Resource_action")
consumed_on_use = true
