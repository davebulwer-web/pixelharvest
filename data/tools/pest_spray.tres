[gd_resource type="Resource" script_class="ToolDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/tool_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/tools/spray_action.gd" id="2_action"]
[ext_resource type="Texture2D" path="res://assets/sprites/items/pest_spray.png" id="3_icon"]
[ext_resource type="Resource" path="res://data/unlocks/pests_arrive.tres" id="4_unlock"]

[sub_resource type="Resource" id="Resource_action"]
script = ExtResource("2_action")

[resource]
script = ExtResource("1_def")
id = &"pest_spray"
display_name = "Pest spray"
description = "One dose clears the aphids off one crop. Space on the crop to spray it."
icon = ExtResource("3_icon")
buy_price = 20
energy_cost = 1.0
action = SubResource("Resource_action")
consumed_on_use = true
sold_only_by = Array[StringName]([&"general_store"])
requires_unlock = ExtResource("4_unlock")
