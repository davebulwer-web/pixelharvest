[resource]
script = ExtResource("1_def")
id = &"growth_feed"
display_name = "Growth feed"
description = "Space on tilled soil feeds it. Seeds sown in fed soil come up at once, a stage ahead. It stays in the soil until it goes back to grass."
icon = ExtResource("3_icon")
buy_price = 40
energy_cost = 1.0
action = SubResource("Resource_action")
consumed_on_use = true
sold_only_by = Array[StringName]([&"general_store"])
requires_unlock = ExtResource("5_unlock")
skips_stages = 1
soil_look = ExtResource("4_soil")
