[resource]
script = ExtResource("1_def")
id = &"mulch"
display_name = "Mulch"
description = "Space on tilled soil spreads it. Watered soil under mulch stays wet a night longer: one can lasts two nights. It stays until the soil goes back to grass."
icon = ExtResource("3_icon")
buy_price = 25
energy_cost = 1.0
action = SubResource("Resource_action")
consumed_on_use = true
sold_only_by = Array[StringName]([&"general_store"])
requires_unlock = ExtResource("5_unlock")
keeps_wet_nights = 1
soil_look = ExtResource("4_soil")
