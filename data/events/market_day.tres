[gd_resource type="Resource" script_class="CalendarEvent" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/resources/calendar_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/resources/stall_def.gd" id="2_stall"]
[ext_resource type="Resource" path="res://data/shops/market_grocer.tres" id="3_grocer"]
[ext_resource type="Resource" path="res://data/shops/market_seeds.tres" id="4_seeds"]
[ext_resource type="Texture2D" path="res://assets/sprites/town/market_stall_produce.png" id="5_produce_pic"]
[ext_resource type="Texture2D" path="res://assets/sprites/town/market_stall_seeds.png" id="6_seeds_pic"]

[sub_resource type="Resource" id="Resource_grocer_stall"]
script = ExtResource("2_stall")
shop = ExtResource("3_grocer")
cell = Vector2i(17, 21)
picture = ExtResource("5_produce_pic")

[sub_resource type="Resource" id="Resource_seed_stall"]
script = ExtResource("2_stall")
shop = ExtResource("4_seeds")
cell = Vector2i(23, 21)
picture = ExtResource("6_seeds_pic")

[resource]
script = ExtResource("1_event")
id = &"market_day"
display_name = "Market day"
first_day = 3
every_days = 7
location = &"town"
description = "Stalls in the square: Rosa pays more than the bin for vegetables, and Fennel sells rare seeds."
stalls = Array[ExtResource("2_stall")]([SubResource("Resource_grocer_stall"), SubResource("Resource_seed_stall")])
