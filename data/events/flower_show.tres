[gd_resource type="Resource" script_class="CalendarEvent" load_steps=17 format=3]

[ext_resource type="Script" path="res://scripts/resources/calendar_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/resources/stall_def.gd" id="2_stall"]
[ext_resource type="Script" path="res://scripts/resources/contest_def.gd" id="3_r"]
[ext_resource type="Script" path="res://scripts/resources/contest_rival.gd" id="4_r"]
[ext_resource type="Script" path="res://scripts/resources/contest_prize.gd" id="5_r"]
[ext_resource type="Script" path="res://scripts/festivals/best_item_rule.gd" id="6_r"]
[ext_resource type="Resource" path="res://data/decorations/bird_bath.tres" id="7_r"]

[sub_resource type="Resource" id="Resource_rule"]
script = ExtResource("6_r")
tag = &"flower"
bonus_object = &"garden_flower_bed"
bonus_each = 10
bonus_most = 50

[sub_resource type="Resource" id="Resource_rival0"]
script = ExtResource("4_r")
name = "Mrs Pell"
entry = "sweet pea"
min_score = 35
max_score = 60

[sub_resource type="Resource" id="Resource_rival1"]
script = ExtResource("4_r")
name = "the vicar"
entry = "primrose posy"
min_score = 30
max_score = 55

[sub_resource type="Resource" id="Resource_rival2"]
script = ExtResource("4_r")
name = "Old Tom"
entry = "bluebell"
min_score = 25
max_score = 50

[sub_resource type="Resource" id="Resource_rival3"]
script = ExtResource("4_r")
name = "the Harker twins"
entry = "daffodils"
min_score = 40
max_score = 70

[sub_resource type="Resource" id="Resource_prize0"]
script = ExtResource("5_r")
gold = 250
items = Dictionary[Resource, int]({ExtResource("7_r"): 1})

[sub_resource type="Resource" id="Resource_prize1"]
script = ExtResource("5_r")
gold = 120

[sub_resource type="Resource" id="Resource_prize2"]
script = ExtResource("5_r")
gold = 50

[sub_resource type="Resource" id="Resource_contest"]
script = ExtResource("3_r")
rule = SubResource("Resource_rule")
judged_at = 840
rivals = Array[ExtResource("4_r")]([SubResource("Resource_rival0"), SubResource("Resource_rival1"), SubResource("Resource_rival2"), SubResource("Resource_rival3")])
prizes = Array[ExtResource("5_r")]([SubResource("Resource_prize0"), SubResource("Resource_prize1"), SubResource("Resource_prize2")])
invite_lines = Array[String](["The flower show! Every spring, the best bloom in the valley wins a prize.", "One flower each, judged at two o'clock. And I do like to hear of a farm with flower beds about the place."])
question = "What will you put on the table?"
nothing_line = "You've no flowers with you. Tulips grow in spring: Hollis has the bulbs."
entered_line = "A lovely {entry}! On the table it goes. Judging's at {time}, right here."
waiting_line = "Your {entry} is on the table ({score}). Judging's at {time}."
results_line = "The flower show results!"

[resource]
script = ExtResource("1_event")
id = &"flower_show"
display_name = "Spring flower show"
first_day = 24
every_days = 112
seasons = Array[StringName]([&"spring"])
location = &"town"
description = "Bring your best flower to Mayor Bramble's table in the square. Flower beds on your farm win the judge's favour."
stalls = Array[ExtResource("2_stall")]([])
host = &"mayor"
host_cell = Vector2i(21, 16)
contest = SubResource("Resource_contest")
decorations = Dictionary[Vector2i, StringName]({Vector2i(15, 17): &"festival_flag", Vector2i(25, 17): &"festival_flag_blue", Vector2i(23, 16): &"show_table_flowers"})
