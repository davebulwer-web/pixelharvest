[gd_resource type="Resource" script_class="CalendarEvent" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/resources/calendar_event.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/resources/stall_def.gd" id="2_stall"]
[ext_resource type="Resource" path="res://data/decorations/paper_lantern.tres" id="3_r"]

[resource]
script = ExtResource("1_event")
id = &"lantern_night"
display_name = "Lantern night"
first_day = 112
every_days = 112
seasons = Array[StringName]([&"winter"])
location = &"town"
description = "The year's last night: the town lights lanterns in the square. Come and see Mayor Bramble."
stalls = Array[ExtResource("2_stall")]([])
host = &"mayor"
host_cell = Vector2i(21, 16)
host_lines = Array[String](["Lantern night! The last night of the year, and the whole valley's out.", "A year ago that farm of yours was thistles. Look at it now."])
gift_items = Dictionary[Resource, int]({ExtResource("3_r"): 1})
gift_line = "Here, one for your farm. Hang it up and remember the year by it."
decorations = Dictionary[Vector2i, StringName]({Vector2i(16, 16): &"festival_lantern", Vector2i(24, 16): &"festival_lantern", Vector2i(16, 20): &"festival_lantern", Vector2i(24, 20): &"festival_lantern"})
