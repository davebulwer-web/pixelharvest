[resource]
script = ExtResource("1_t")
id = &"board_wren"
posted_at = &"notice_board"
client = "Wren"
title = "Help wanted: {count} {item} for Wren"
choice_line = ""
offer_line = "Wren's promised the inn {count} {item} for tonight's supper, and nothing's biting for him. {gold}g to whoever brings them."
reminder_line = "Wren's {count} {item} for the inn, by tonight."
thanks_line = "You leave the {item} in the crate under the board, on a bed of wet grass. {client}'s {gold}g is pinned up waiting."
news_line = "There's a job on the notice board today."
items = Array[ExtResource("2_t")]([ExtResource("4_i"), ExtResource("5_i"), ExtResource("6_i"), ExtResource("7_i"), ExtResource("8_i"), ExtResource("9_i"), ExtResource("10_i"), ExtResource("11_i"), ExtResource("12_i")])
count_min = 1
count_max = 3
max_value = 150
pay_rate = 1.6
bonus_gold = 10
deadline_days = 1
choices = 1
weight = 1
first_day = 1
on_event = &""
requires_unlock = ExtResource("3_t")
