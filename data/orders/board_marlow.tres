[resource]
script = ExtResource("1_t")
id = &"board_marlow"
posted_at = &"notice_board"
client = "Marlow"
title = "Help wanted: {count} {item} for Marlow"
choice_line = ""
offer_line = "Marlow at the general store needs {count} {item} today. Leave them in the crate under the board by tonight: {gold}g."
reminder_line = "Marlow's {count} {item}, in the crate under the board by tonight."
thanks_line = "You leave the {item} in the crate under the board. {client}'s {gold}g is pinned up waiting."
news_line = "There's a job on the notice board today."
items = Array[ExtResource("2_t")]([ExtResource("4_i"), ExtResource("5_i"), ExtResource("6_i"), ExtResource("7_i"), ExtResource("8_i"), ExtResource("9_i"), ExtResource("10_i"), ExtResource("11_i"), ExtResource("12_i"), ExtResource("13_i"), ExtResource("14_i"), ExtResource("15_i"), ExtResource("16_i"), ExtResource("17_i"), ExtResource("18_i"), ExtResource("19_i"), ExtResource("20_i")])
count_min = 3
count_max = 6
max_value = 360
pay_rate = 1.4
bonus_gold = 10
deadline_days = 1
choices = 1
weight = 3
first_day = 1
on_event = &""
requires_unlock = ExtResource("3_t")
