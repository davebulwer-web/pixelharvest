[resource]
script = ExtResource("1_t")
id = &"rosa_orders"
posted_at = &"market_grocer"
client = ""
title = "Rosa's order: {count} {item}"
choice_line = "The city buyers sent their list for next week. Which can you grow me? Half as much again as the bin, if they're here by next market day."
offer_line = "{count} {item} by next market day, then. {gold}g when you bring them. Don't let me down!"
reminder_line = "My {count} {item} for the city? I need them by market day."
thanks_line = "Just what the city asked for. Here's your {gold}g, as promised."
news_line = "Market day: Rosa is taking orders for next week."
items = Array[ExtResource("2_t")]([ExtResource("4_i"), ExtResource("5_i"), ExtResource("6_i"), ExtResource("7_i"), ExtResource("8_i"), ExtResource("9_i"), ExtResource("10_i"), ExtResource("11_i"), ExtResource("12_i"), ExtResource("13_i"), ExtResource("14_i"), ExtResource("15_i"), ExtResource("16_i"), ExtResource("17_i"), ExtResource("18_i"), ExtResource("19_i"), ExtResource("20_i"), ExtResource("21_i"), ExtResource("22_i"), ExtResource("23_i"), ExtResource("24_i"), ExtResource("25_i")])
count_min = 4
count_max = 10
max_value = 700
pay_rate = 1.5
bonus_gold = 0
deadline_days = 8
choices = 3
weight = 1
first_day = 1
on_event = &"market_day"
requires_unlock = ExtResource("3_t")
