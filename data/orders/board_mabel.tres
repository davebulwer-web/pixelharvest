[resource]
script = ExtResource("1_t")
id = &"board_mabel"
posted_at = &"notice_board"
client = "Mabel"
title = "Help wanted: {count} {item} for Mabel"
choice_line = ""
offer_line = "Mabel's baking for a wedding and has run short: {count} {item}, today please. Leave them in the crate under the board: {gold}g."
reminder_line = "Mabel's {count} {item} for the wedding baking, by tonight."
thanks_line = "You leave the {item} in the crate under the board. {client}'s {gold}g is pinned up waiting."
news_line = "There's a job on the notice board today."
items = Array[ExtResource("2_t")]([ExtResource("4_i"), ExtResource("5_i"), ExtResource("6_i"), ExtResource("7_i"), ExtResource("8_i"), ExtResource("9_i"), ExtResource("10_i"), ExtResource("11_i")])
count_min = 2
count_max = 5
max_value = 400
pay_rate = 1.4
bonus_gold = 15
deadline_days = 1
choices = 1
weight = 2
first_day = 1
on_event = &""
requires_unlock = ExtResource("3_t")
