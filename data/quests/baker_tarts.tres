[gd_resource type="Resource" script_class="QuestDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_def.gd" id="1_r"]
[ext_resource type="Script" path="res://scripts/quests/deliver_any_goal.gd" id="2_r"]
[ext_resource type="Script" path="res://scripts/resources/item_def.gd" id="3_r"]
