[resource]
script = ExtResource("1_r")
id = &"tam_crabs"
title = "Crabs for the city"
giver = &"tam"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["There's a restaurant in the city wants brown crabs, and I've not the pots to keep up.", "Bring me three brown crabs out of your pots and I'll pay you what they pay me. Better than I'd give you over the counter."])
reminder_line = "Three brown crabs. The big ones, with the black-tipped claws."
thanks_lines = Array[String](["Lovely. They'll go up on the evening cart.", "There's your share. I'll be wanting more of those."])
reward_gold = 200
requires = ExtResource("3_r")
