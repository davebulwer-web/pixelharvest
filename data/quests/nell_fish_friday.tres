[resource]
script = ExtResource("1_r")
id = &"nell_fish_friday"
title = "Fish on a Friday"
giver = &"nell"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Darts night's busy, and a busy bar wants feeding. Fish and chips, that's what they want.", "Tam can't spare me enough. Catch me four sea fish, any kind, off the pier, and I'll fry suppers every night."])
reminder_line = "Four sea fish for the fryer. Any kind off the pier will do."
thanks_lines = Array[String](["Fresh as the morning. I'll have the fryer going by tonight.", "Fish suppers on the menu from now on. And here's for your trouble."])
reward_gold = 180
reward_unlocks = Array[ExtResource("23_r")]([ExtResource("24_r")])
requires = ExtResource("25_r")
first_day = 1
