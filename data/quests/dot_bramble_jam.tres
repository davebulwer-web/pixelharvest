[resource]
script = ExtResource("1_r")
id = &"dot_bramble_jam"
title = "Dot's sister's jam"
giver = &"dot"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Every autumn I send a parcel to my sister in the city: jam, and a taste of the valley.", "Eight things off the hedgerows: blackberries, sloes, rosehips, hazelnuts, any mix. I'll do the jamming."])
reminder_line = "Eight from the hedgerows, any mix: blackberries, sloes, rosehips, hazelnuts."
thanks_lines = Array[String](["That'll make a parcel to be proud of. She'll be jealous of the valley again.", "There's your share, and a jar of last year's for the larder."])
reward_gold = 220
requires = ExtResource("17_r")
first_day = 1
seasons = Array[StringName]([&"autumn"])
