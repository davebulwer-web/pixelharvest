[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("2_r")
water = &"stream"
where = "the Woods' stream"

[resource]
script = ExtResource("1_r")
id = &"wren_river_fish"
title = "The river fish"
giver = &"angler"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["The pond and the river, you've had those. But the best water's over the bridge.", "The Woods' stream: cold, quick, and full of trout. Minnows too, if you're unlucky.", "Catch me one fish from the stream, any fish, and I'll know you're a proper angler."])
reminder_line = "One fish from the Woods' stream. The trout like the quick water."
thanks_lines = Array[String](["From the stream! Cold hands, I bet.", "You've earned better than that old thing. Give it here: take my good rod, the split cane.", "A fine rod feels the bite before the float does. You'll find they come a good deal sooner.", "And if you've a stove, grill the next one you catch. A pinch of salt, that's all a fresh fish wants."])
reward_upgrades = Array[ExtResource("4_r")]([ExtResource("5_r")])
reward_recipes = Array[ExtResource("6_r")]([ExtResource("7_r")])
requires = ExtResource("3_r")
first_day = 43
