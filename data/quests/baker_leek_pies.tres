[resource]
script = ExtResource("1_r")
id = &"baker_leek_pies"
title = "Mabel's leek pies"
giver = &"baker"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Brr! Winter's for pies, love, and nothing warms you like a leek pie.", "Five leeks, if you've any in the ground. They don't mind the cold."])
reminder_line = "Five leeks for the winter pies, love."
thanks_lines = Array[String](["Oh, lovely thick ones. The whole street will smell of pie tonight.", "And take this: my old recipe book. Soups, stews, a fish pie. I know them all by heart now.", "Once your stove's lit, these'll keep you going through the cold. Keep warm out on that farm."])
reward_gold = 500
reward_recipes = Array[ExtResource("5_r")]([ExtResource("6_r"), ExtResource("7_r"), ExtResource("8_r"), ExtResource("9_r"), ExtResource("10_r"), ExtResource("11_r")])
requires = ExtResource("4_r")
first_day = 1
seasons = Array[StringName]([&"winter"])
