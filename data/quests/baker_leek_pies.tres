[resource]
script = ExtResource("1_r")
id = &"baker_leek_pies"
title = "Mabel's leek pies"
giver = &"baker"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Brr! Winter's for pies, love, and nothing warms you like a leek pie.", "Five leeks, if you've any in the ground. They don't mind the cold."])
reminder_line = "Five leeks for the winter pies, love."
thanks_lines = Array[String](["Oh, lovely thick ones. The whole street will smell of pie tonight.", "There you are. Keep warm out on that farm."])
reward_gold = 500
requires = ExtResource("4_r")
first_day = 1
seasons = Array[StringName]([&"winter"])
