[gd_resource type="Resource" script_class="QuestDef" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_def.gd" id="1_r"]
[ext_resource type="Script" path="res://scripts/quests/deliver_any_goal.gd" id="2_r"]
[ext_resource type="Script" path="res://scripts/resources/item_def.gd" id="3_r"]
[ext_resource type="Resource" path="res://data/forage/shrimp.tres" id="4_r"]
[ext_resource type="Resource" path="res://data/forage/mussels.tres" id="5_r"]
[ext_resource type="Resource" path="res://data/forage/winkles.tres" id="6_r"]
[ext_resource type="Resource" path="res://data/forage/shore_crab.tres" id="7_r"]
[ext_resource type="Resource" path="res://data/forage/oyster.tres" id="8_r"]
[ext_resource type="Resource" path="res://data/tools/handline.tres" id="9_r"]
[ext_resource type="Resource" path="res://data/unlocks/tam_arrives.tres" id="10_r"]

[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("2_r")
amount = 3
items = Array[ExtResource("3_r")]([ExtResource("6_r"), ExtResource("5_r"), ExtResource("4_r"), ExtResource("7_r"), ExtResource("8_r")])
what = "rockpool finds"

[resource]
script = ExtResource("1_r")
id = &"tam_rockpools"
title = "Tam's bait bucket"
giver = &"tam"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["You'll be the one who took the old farm. Tam. I fish out of this cove, when the sea lets me.", "My bait bucket's empty and my knees won't take the rocks today. Bring me three things out of the rockpools, would you? Winkles, mussels, shrimps, whatever's in.", "The pools only show at low tide. The board by the path says when."])
reminder_line = "Three from the rockpools. Low tide uncovers them: check the board."
thanks_lines = Array[String](["That'll fill the bucket nicely.", "Here, take my old handline. No rod, just a frame, a line and a lead. Stand on the pier or the quay, face the sea and drop it in.", "Fish bite best when the tide's in. And the sea never freezes, so there's fishing here all winter."])
reward_items = Dictionary[ExtResource("3_r"), int]({
ExtResource("9_r"): 1
})
first_day = 7
requires_unlock = ExtResource("10_r")
