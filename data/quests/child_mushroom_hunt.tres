[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("2_r")
items = Array[ExtResource("3_r")]([ExtResource("4_r"), ExtResource("5_r"), ExtResource("6_r")])

[resource]
script = ExtResource("1_r")
id = &"child_mushroom_hunt"
title = "Pip's mushroom hunt"
giver = &"child"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["My book has a whole page of mushrooms, and it says autumn's the best time for them. In the Woods!", "I'm not allowed over the bridge on my own. Could you find me three? A chanterelle, a penny bun and a puffball. Those are the ones in the pictures.", "I just want to look at them. And maybe poke the puffball."])
reminder_line = "Any mushrooms yet? A chanterelle, a penny bun and a puffball. Check the clearings!"
thanks_lines = Array[String](["They're real! They look just like the pictures!", "*poke* ...It puffed! Here, this is all my pocket money. It's worth it."])
reward_gold = 200
first_day = 61
seasons = Array[StringName]([&"autumn"])
requires_unlock = ExtResource("8_r")
