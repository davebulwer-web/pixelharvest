[gd_resource type="Resource" script_class="QuestDef" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_def.gd" id="1_r"]
[ext_resource type="Script" path="res://scripts/quests/deliver_each_goal.gd" id="2_r"]
[ext_resource type="Script" path="res://scripts/resources/item_def.gd" id="3_r"]
[ext_resource type="Resource" path="res://data/produce/tomato.tres" id="4_r"]
[ext_resource type="Resource" path="res://data/produce/green_bean.tres" id="5_r"]
[ext_resource type="Resource" path="res://data/produce/sunflower.tres" id="6_r"]
[ext_resource type="Resource" path="res://data/produce/watercress.tres" id="7_r"]
[ext_resource type="Resource" path="res://data/produce/corn.tres" id="8_r"]
[ext_resource type="Resource" path="res://data/tools/chilli_seeds.tres" id="9_r"]
[ext_resource type="Script" path="res://scripts/resources/unlock_def.gd" id="10_r"]
[ext_resource type="Resource" path="res://data/unlocks/hollis_autumn.tres" id="11_r"]
[ext_resource type="Resource" path="res://data/unlocks/hollis_chilli.tres" id="12_r"]
[ext_resource type="Resource" path="res://data/quests/hollis_spring_set.tres" id="13_r"]

[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("2_r")
items = Array[ExtResource("3_r")]([ExtResource("4_r"), ExtResource("5_r"), ExtResource("6_r"), ExtResource("7_r"), ExtResource("8_r")])

[resource]
script = ExtResource("1_r")
id = &"hollis_summer_set"
title = "Hollis's summer set"
giver = &"seed_shop"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["You took to the spring seeds well. Let's see what you make of summer.", "One each of tomato, green bean, sunflower, watercress and corn. Manage that, and you'll have my autumn seeds early.", "And I'll start keeping chilli seeds for you. Fennel charges the earth for them."])
reminder_line = "Summer's short. One of each, before the autumn comes in."
thanks_lines = Array[String](["Every one of them, and good ones too.", "My autumn seeds are out for you from today. I've ordered chilli seeds in as well, and here's a few to start you off. They love a heatwave."])
reward_gold = 250
reward_items = Dictionary[ExtResource("3_r"), int]({
ExtResource("9_r"): 3
})
reward_unlocks = Array[ExtResource("10_r")]([ExtResource("11_r"), ExtResource("12_r")])
requires = ExtResource("13_r")
first_day = 1
seasons = Array[StringName]([&"summer"])
