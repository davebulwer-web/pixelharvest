[resource]
script = ExtResource("1_r")
id = &"rosa_first_crate"
title = "Rosa's first crate"
giver = &"market_grocer"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["You're the one who took on the old farm! I've a buyer in the city who wants country vegetables, and I want to know if yours are up to it.", "Bring me a crate: eight vegetables, any mix. If the city likes them, I'll take orders from you every market day."])
reminder_line = "Eight vegetables for my crate, any mix you like."
thanks_lines = Array[String](["Now that's a crate. The city will take every one.", "From next market day, come and see what they're asking for. I'll pay you well for it."])
reward_gold = 60
reward_unlocks = Array[ExtResource("4_r")]([ExtResource("5_r")])
first_day = 10
on_event = &"market_day"
