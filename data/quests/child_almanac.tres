[resource]
script = ExtResource("1_r")
id = &"child_almanac"
title = "Pip's shadows"
giver = &"child"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Is it true you've got a book with everything in it? Can I see? ...Some of them are just shadows!", "I want to know what the shadows are. Find five things that aren't in the book yet, and then tell me what they were!"])
reminder_line = "Any shadows filled in yet? Five! The book has hints under the shadows."
thanks_lines = Array[String](["[happy]Five! So that's what that shadow was. I knew it had teeth!", "Here, I saved my pocket money for when you did it."])
reward_gold = 300
first_day = 141
requires_unlock = ExtResource("3_r")
