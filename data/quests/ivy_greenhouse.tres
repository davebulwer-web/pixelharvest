[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("2_r")
item = ExtResource("3_r")
amount = 30
fee = 800

[resource]
script = ExtResource("1_r")
id = &"ivy_greenhouse"
title = "A glasshouse of your own"
giver = &"ivy"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["I said I had an idea for your farm, didn't I? There's an old greenhouse by your farmhouse. I saw it from the road.", "The glazier's still in the valley, and he's done my panes for less than he feared. He'd do yours for eight hundred gold.", "And thirty lengths of timber for a new door and the rotten bars. Then you'll have soil that never feels the frost: plant what you like, whenever you like."])
reminder_line = "Thirty timber and eight hundred for the glazier, dear. Then the greenhouse is yours again."
thanks_lines = Array[String](["Good. The glazier's been itching to get up your farm track. He'll be done before you're home.", "Strawberries in the snow, dear! Take these to start you off.", "It ignores the seasons, but not the watering can. Nothing rains in there."])
reward_items = Dictionary[ExtResource("7_r"), int]({
ExtResource("8_r"): 5
})
reward_unlocks = Array[ExtResource("5_r")]([ExtResource("6_r")])
requires = ExtResource("4_r")
