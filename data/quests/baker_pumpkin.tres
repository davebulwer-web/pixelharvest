[gd_resource type="Resource" script_class="QuestDef" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/quests/deliver_goal.gd" id="2_goal"]
[ext_resource type="Resource" path="res://data/produce/pumpkin.tres" id="3_item"]
[ext_resource type="Script" path="res://scripts/resources/item_def.gd" id="5_itemdef"]
