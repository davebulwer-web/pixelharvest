[gd_resource type="Resource" script_class="QuestDef" load_steps=16 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_def.gd" id="1_r"]
[ext_resource type="Script" path="res://scripts/quests/deliver_each_goal.gd" id="2_r"]
[ext_resource type="Script" path="res://scripts/resources/item_def.gd" id="3_r"]
[ext_resource type="Resource" path="res://data/produce/parsnip.tres" id="4_r"]
[ext_resource type="Resource" path="res://data/produce/radish.tres" id="5_r"]
[ext_resource type="Resource" path="res://data/produce/potato.tres" id="6_r"]
[ext_resource type="Resource" path="res://data/produce/spring_onion.tres" id="7_r"]
[ext_resource type="Resource" path="res://data/produce/pea.tres" id="8_r"]
[ext_resource type="Resource" path="res://data/produce/tulip.tres" id="9_r"]
[ext_resource type="Resource" path="res://data/tools/rhubarb_seeds.tres" id="10_r"]
[ext_resource type="Script" path="res://scripts/resources/unlock_def.gd" id="11_r"]
[ext_resource type="Resource" path="res://data/unlocks/hollis_summer.tres" id="12_r"]
[ext_resource type="Resource" path="res://data/unlocks/rhubarb_crowns.tres" id="13_r"]
[ext_resource type="Resource" path="res://data/unlocks/hollis_spring.tres" id="14_r"]

[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("2_r")
items = Array[ExtResource("3_r")]([ExtResource("4_r"), ExtResource("5_r"), ExtResource("6_r"), ExtResource("7_r"), ExtResource("8_r"), ExtResource("9_r")])

[resource]
script = ExtResource("1_r")
id = &"hollis_spring_set"
title = "Hollis's spring set"
giver = &"seed_shop"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["I'll tell you what I tell every new grower. Anyone can grow parsnips. A real farmer grows the lot.", "Bring me one of everything I sell for spring: parsnip, radish, potato, spring onion, pea and a tulip. Do that and I'll open my summer seeds to you early.", "And I'll let you have my rhubarb crowns. I don't sell those to just anyone."])
reminder_line = "One of each, mind. Show me the whole spring."
thanks_lines = Array[String](["Well now. That's a proper spring's growing, that is.", "My summer seeds are yours from today, a week ahead of anybody. And here's a couple of rhubarb crowns. Plant them once and they come back every spring."])
reward_gold = 150
reward_items = Dictionary[ExtResource("3_r"), int]({
ExtResource("10_r"): 2
})
reward_unlocks = Array[ExtResource("11_r")]([ExtResource("12_r"), ExtResource("13_r")])
first_day = 18
seasons = Array[StringName]([&"spring"])
requires_unlock = ExtResource("14_r")
