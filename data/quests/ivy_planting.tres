[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("2_r")
items = Array[ExtResource("3_r")]([ExtResource("7_r"), ExtResource("8_r"), ExtResource("9_r")])
and_one_of = Array[ExtResource("3_r")]([ExtResource("10_f"), ExtResource("11_f"), ExtResource("12_f"), ExtResource("13_f"), ExtResource("14_f"), ExtResource("15_f"), ExtResource("16_f"), ExtResource("17_f"), ExtResource("18_f"), ExtResource("19_f"), ExtResource("20_f"), ExtResource("21_f"), ExtResource("22_f"), ExtResource("23_f"), ExtResource("24_f")])
and_one_of_what = "a fish"

[resource]
script = ExtResource("1_r")
id = &"ivy_planting"
title = "Ivy's first planting"
giver = &"ivy"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Look at it! Every pane in, and not a crack. I could cry.", "Now, the old way to start a glasshouse: the best of the autumn, laid out on the bench, and a fish from the water for the soil. My mother swore by it.", "One pumpkin, one cranberry, one beetroot, and a fish. Any fish. Then we plant."])
reminder_line = "A pumpkin, a cranberry, a beetroot and a fish, dear. Any fish will do."
thanks_lines = Array[String](["The fish goes under the bench, the rest on top. There.", "It's alive again. Listen: you can hear it breathing.", "Thank you, dear. I'll be growing things in here all winter, and I've an idea for your farm, once you're ready for it."])
reward_gold = 500
reward_unlocks = Array[ExtResource("5_r")]([ExtResource("6_r")])
requires = ExtResource("4_r")
seasons = Array[StringName]([&"autumn"])
