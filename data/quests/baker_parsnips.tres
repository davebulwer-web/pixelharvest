[resource]
script = ExtResource("1_def")
id = &"baker_parsnips"
title = "Mabel's parsnip cakes"
giver = &"baker"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Oh, you're the new farmer? I'm Mabel. I bake for half the town.", "I'm making parsnip cakes for the spring, but I can't get parsnips for love nor money. Could you bring me five?"])
reminder_line = "Any luck with those parsnips, love?"
thanks_lines = Array[String](["Lovely, fresh as anything! The cakes will be the talk of the town.", "Here, for your trouble."])
reward_gold = 250
first_day = 1
seasons = Array[StringName]([&"spring"])
