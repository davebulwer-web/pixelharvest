[resource]
script = ExtResource("1_r")
id = &"baker_kitchen"
title = "Mabel's kitchen lessons"
giver = &"baker"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["You look worn through, love. Out in those fields from dawn on nothing but a crust, I'll bet.", "There's a stove in that farmhouse of yours, I know there is. Let me teach you my three favourites.", "Bring me what goes in them: a tomato, a green bean, a potato and some fruit. Berries, an apple, whatever you've got. We'll cook them together."])
reminder_line = "A tomato, a green bean, a potato and some fruit, love, and you'll have your first lesson."
thanks_lines = Array[String](["Right. Sleeves up. Soup first: you can't go wrong with soup.", "There. Tomato soup, a potato and bean hash, and a crumble with whatever fruit's about. Light that stove when you get home.", "A good dish puts the strength back in you. Eat when you're flagging, not when you're done in."])
reward_unlocks = Array[ExtResource("13_r")]([ExtResource("14_r")])
reward_recipes = Array[ExtResource("15_r")]([ExtResource("16_r"), ExtResource("17_r"), ExtResource("18_r")])
requires = ExtResource("12_r")
first_day = 43
seasons = Array[StringName]([&"summer", &"autumn"])
