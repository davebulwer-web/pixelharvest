[resource]
script = ExtResource("1_def")
id = &"baker_potatoes"
title = "Mabel's pasties"
giver = &"baker"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["The parsnip cakes sold out in a morning!", "Next it's pasties. Bring me five potatoes and I'll make it worth your while."])
reminder_line = "Pasties without potatoes are just pastry, love."
thanks_lines = Array[String](["Perfect spuds. The pasties will fly off the shelf.", "There. You've earned every coin."])
reward_gold = 400
requires = ExtResource("7_requires")
first_day = 1
seasons = Array[StringName]([&"spring", &"summer"])
