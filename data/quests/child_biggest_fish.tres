[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("2_r")
min_size = 40

[resource]
script = ExtResource("1_r")
id = &"child_biggest_fish"
title = "Pip's biggest fish"
giver = &"child"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Wren says you can fish now! Have you caught a really big one?", "Bigger than my arm? My arm is forty centimetres. I measured it.", "If you catch one bigger than my arm, I'll give you my best treasure."])
reminder_line = "A fish bigger than my arm: forty centimetres! Carp get big. So do pike, in the cold."
thanks_lines = Array[String](["Forty centimetres or MORE? That's bigger than my arm!", "Here's my best treasure: a spinner I found in the reeds. Wren says it's a real one. Keep it in your bag and the fish will want to look at it."])
reward_items = Dictionary[ExtResource("3_r"), int]({
ExtResource("4_r"): 1
})
first_day = 43
seasons = Array[StringName]([&"summer", &"autumn", &"winter"])
requires_unlock = ExtResource("6_r")
