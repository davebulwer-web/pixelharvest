[resource]
script = ExtResource("1_r")
id = &"dot_mounting_block"
title = "A mounting block for Dot"
giver = &"dot"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["My knees, farmer. Getting up on that cart's a climb, and getting down's worse.", "A mounting block by the gate is what I want. Twelve good stones from that field of yours, and I'll have the Lane's best."])
reminder_line = "Twelve stones for the mounting block. Your field's full of them."
thanks_lines = Array[String](["Lovely and solid. My knees thank you, and so do I.", "Here's for the carrying. You've a carrier's back on you, you know."])
reward_gold = 120
requires = ExtResource("13_r")
first_day = 6
