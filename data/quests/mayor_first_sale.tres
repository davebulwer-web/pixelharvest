[gd_resource type="Resource" script_class="QuestDef" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/quests/sell_goal.gd" id="2_goal"]
[ext_resource type="Script" path="res://scripts/resources/item_def.gd" id="5_itemdef"]
[ext_resource type="Resource" path="res://data/tools/potato_seeds.tres" id="6_reward0"]
[ext_resource type="Resource" path="res://data/quests/mayor_first_pull.tres" id="7_requires"]

[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("2_goal")
amount = 200

[resource]
script = ExtResource("1_def")
id = &"mayor_first_sale"
title = "The mayor's welcome"
giver = &"mayor"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Now, may I ask another small favour?", "The town does better when its farms do. Sell 200 gold's worth of produce, any way you like: the bin on your farm, Marlow's store, or the market."])
reminder_line = "How's the selling going? Every coin counts."
thanks_lines = Array[String](["Splendid! The old farm's paying its way again.", "Here, potato seeds from my own shed. They grow in spring and summer both."])
reward_gold = 50
reward_items = Dictionary[ExtResource("5_itemdef"), int]({
ExtResource("6_reward0"): 5
})
requires = ExtResource("7_requires")
first_day = 1
