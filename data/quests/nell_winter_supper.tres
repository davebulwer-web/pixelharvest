[resource]
script = ExtResource("1_r")
id = &"nell_winter_supper"
title = "The winter supper"
giver = &"nell"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Every winter the Wheatsheaf puts on a supper for the whole valley. The first in ten years, this'll be.", "I want the best of the winter garden: a leek, some kale and sprouts. And a fish from the sea, whatever's biting."])
reminder_line = "A leek, kale, sprouts, and a sea fish, for the winter supper."
thanks_lines = Array[String](["That's the supper made. The whole valley's coming, you know. They'll know who grew it.", "Here. Nobody pays for a drink at the Wheatsheaf who fed the valley in winter. Well: nearly nobody."])
reward_gold = 450
requires = ExtResource("26_r")
first_day = 1
seasons = Array[StringName]([&"winter"])
