[resource]
script = ExtResource("1_r")
id = &"blacksmith_brass"
title = "The brass sprinkler"
giver = &"blacksmith"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Quiet time of year at the forge. Good time for the piece I've always wanted to make.", "A sprinkler all of brass. Two tiles out on every side: twenty-four tiles, every morning. It'll outlast the both of us.", "Brass isn't cheap: 2500 gold. And my old master quenched his brass in a broth of velvet shank, the little orange mushroom that grows through the frost. Keeps it from going green. Bring me three from the Woods."])
reminder_line = "Three velvet shanks from the Woods, and 2500 for the brass."
thanks_lines = Array[String](["That's the smell. Just as I remember it. Stand back, this'll hiss.", "There she is. The finest thing I've made. She's yours.", "I'll make more to order now, if you've the gold. They're on my shelf."])
reward_items = Dictionary[ExtResource("7_r"), int]({
ExtResource("8_r"): 1
})
reward_unlocks = Array[ExtResource("5_r")]([ExtResource("6_r")])
requires = ExtResource("4_r")
first_day = 94
seasons = Array[StringName]([&"winter"])
