[resource]
script = ExtResource("1_r")
id = &"hollis_autumn_set"
title = "Hollis's autumn set"
giver = &"seed_shop"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Autumn's the grower's season. The cold-hardy ones are the test.", "Beetroot, cabbage, leek and Brussels sprouts: one of each. Then you'll have my winter seeds early."])
reminder_line = "The hardy ones, one of each. They'll stand a frost, those."
thanks_lines = Array[String](["A full year of my seeds, and you've grown the lot. I've not seen that in a long while.", "My winter seeds are yours from today. And take this garlic: plant it now, and it sleeps through the winter and comes up in spring."])
reward_gold = 400
reward_items = Dictionary[ExtResource("3_r"), int]({
ExtResource("8_r"): 5
})
reward_unlocks = Array[ExtResource("9_r")]([ExtResource("10_r")])
requires = ExtResource("11_r")
first_day = 1
seasons = Array[StringName]([&"autumn"])
