[resource]
script = ExtResource("1_r")
id = &"ivy_autumn_set"
title = "Ivy's autumn basket"
giver = &"ivy"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Oh! I didn't hear you come up. I'm Ivy. I kept this glasshouse, a long time ago, when the old farm grew for the whole valley.", "I've come back to see what's left. Not much, as you can see.", "Would you bring me what the valley grows now? One each of beetroot, cabbage, pumpkin and cranberry. I'd like to taste the old soil again."])
reminder_line = "Beetroot, cabbage, pumpkin and cranberry, dear. One of each."
thanks_lines = Array[String](["Oh, that takes me back. The soil's still good, then.", "Take this apple sapling. I grew it from the old orchard's last tree. Plant it where it has room to spread, and it will feed you every year.", "And a few bags of my leaf mould. Spread it on the soil and water it: it stays damp a night longer. Marlow can get you more, I'll tell him.", "One day I'd like this glasshouse whole again. It will need timber, and the Woods are the place for that. When that bridge is built, come and see me."])
reward_gold = 200
reward_items = Dictionary[ExtResource("3_r"), int]({
ExtResource("8_r"): 1,
ExtResource("9_r"): 10
})
reward_unlocks = Array[ExtResource("10_r")]([ExtResource("11_r")])
first_day = 59
seasons = Array[StringName]([&"autumn"])
