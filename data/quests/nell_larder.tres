[resource]
script = ExtResource("1_r")
id = &"nell_larder"
title = "Nell's larder"
giver = &"nell"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["You'll be the farmer! I'm Nell. I've opened up the Wheatsheaf again, my mother's old place.", "Ten years shut, and the larder's as bare as a bone. I want a proper hot meal on the menu, not just bread and cheese.", "Six vegetables, any you've grown, any mix. Bring them to the bar and I'll make it worth your while."])
reminder_line = "Six vegetables for the larder, any mix. I'll be behind the bar from four."
thanks_lines = Array[String](["Look at these! Straight in the pot.", "There: my hotpot's on the menu from tonight. First one's on me. Well, the gold is."])
reward_gold = 100
reward_items = Dictionary[ExtResource("28_r"), int]({
ExtResource("29_r"): 1
})
reward_unlocks = Array[ExtResource("30_r")]([ExtResource("31_r")])
first_day = 8
requires_unlock = ExtResource("32_r")
