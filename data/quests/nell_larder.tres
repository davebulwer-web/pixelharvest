items = Array[ExtResource("12_r")]([ExtResource("13_r"), ExtResource("14_r"), ExtResource("15_r"), ExtResource("16_r"), ExtResource("17_r"), ExtResource("18_r"), ExtResource("19_r"), ExtResource("20_r"), ExtResource("21_r"), ExtResource("22_r"), ExtResource("23_r"), ExtResource("24_r"), ExtResource("25_r"), ExtResource("26_r"), ExtResource("27_r")])
