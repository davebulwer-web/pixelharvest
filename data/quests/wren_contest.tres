[gd_resource type="Resource" script_class="QuestDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_def.gd" id="1_r"]
[ext_resource type="Script" path="res://scripts/quests/catch_goal.gd" id="2_r"]
[ext_resource type="Resource" path="res://data/quests/wren_worms.tres" id="3_r"]

[sub_resource type="Resource" id="Resource_goal"]
script = ExtResource("2_r")
water = &"pond"
location = &"town"
min_size = 25
where = "the town pond"

[resource]
script = ExtResource("1_r")
id = &"wren_contest"
title = "The summer contest"
giver = &"angler"
goal = SubResource("Resource_goal")
offer_lines = Array[String](["Contest day! Once a year, the town pond, sunrise to midnight.", "Rules are simple: land a fish of twenty-five centimetres or more from this pond today, and show me. Any kind.", "The prize is three hundred gold, from the town's purse. Good luck to you."])
reminder_line = "A fish of 25 cm or more from the town pond, today. Tench in the morning are a good bet."
thanks_lines = Array[String](["Now that's a fish! Let me measure... yes, that counts.", "Three hundred gold, as promised. The town will be talking about this one."])
reward_gold = 300
requires = ExtResource("3_r")
on_event = &"fishing_contest"
deadline_days = 1
