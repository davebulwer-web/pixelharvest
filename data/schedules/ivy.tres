words = "at a table in the Wheatsheaf"

[sub_resource type="Resource" id="Stop_sunday_4"]
script = ExtResource("3_stop")
at = 1140
place = &"ivy_cottage"

[sub_resource type="Resource" id="Plan_sunday"]
script = ExtResource("2_plan")
weekdays = Array[int]([6])
requires_unlock = ExtResource("4_unlock")
stops = Array[ExtResource("3_stop")]([SubResource("Stop_sunday_1"), SubResource("Stop_sunday_2"), SubResource("Stop_sunday_3"), SubResource("Stop_sunday_4")])

[sub_resource type="Resource" id="Stop_everyday_1"]
