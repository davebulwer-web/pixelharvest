[gd_resource type="Resource" script_class="ScheduleDef" format=3]

[ext_resource type="Script" path="res://scripts/resources/schedule_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/resources/day_plan.gd" id="2_plan"]
[ext_resource type="Script" path="res://scripts/resources/schedule_stop.gd" id="3_stop"]

[sub_resource type="Resource" id="Plan_rain"]
script = ExtResource("2_plan")
weathers = Array[StringName]([&"rain", &"storm"])
stops = Array[ExtResource("3_stop")]([])

[sub_resource type="Resource" id="Stop_weekend_1"]
script = ExtResource("3_stop")
at = 540
place = &"lane"
cell = Vector2i(52, 10)
words = "playing by the ford on the Lane"

[sub_resource type="Resource" id="Stop_weekend_2"]
script = ExtResource("3_stop")
at = 780
place = &"cove"
cell = Vector2i(34, 22)
words = "on the beach at the Cove"

[sub_resource type="Resource" id="Stop_weekend_3"]
script = ExtResource("3_stop")
at = 1020
place = &"town"
cell = Vector2i(27, 20)
words = "by the town square"

[sub_resource type="Resource" id="Stop_weekend_4"]
script = ExtResource("3_stop")
at = 1140
place = &"pip_cottage"

[sub_resource type="Resource" id="Plan_weekend"]
script = ExtResource("2_plan")
weekdays = Array[int]([5, 6])
stops = Array[ExtResource("3_stop")]([SubResource("Stop_weekend_1"), SubResource("Stop_weekend_2"), SubResource("Stop_weekend_3"), SubResource("Stop_weekend_4")])

[sub_resource type="Resource" id="Stop_everyday_1"]
script = ExtResource("3_stop")
at = 540
place = &"town"
cell = Vector2i(29, 16)
words = "by the town square"

[sub_resource type="Resource" id="Stop_everyday_2"]
script = ExtResource("3_stop")
at = 900
place = &"lane"
cell = Vector2i(52, 10)
words = "playing by the ford on the Lane"

[sub_resource type="Resource" id="Stop_everyday_3"]
script = ExtResource("3_stop")
at = 1140
place = &"pip_cottage"

[sub_resource type="Resource" id="Plan_everyday"]
script = ExtResource("2_plan")
stops = Array[ExtResource("3_stop")]([SubResource("Stop_everyday_1"), SubResource("Stop_everyday_2"), SubResource("Stop_everyday_3")])

[resource]
script = ExtResource("1_def")
home = &"pip_cottage"
home_words = "at home in Pip's cottage on the Lane (knock)"
plans = Array[ExtResource("2_plan")]([SubResource("Plan_rain"), SubResource("Plan_weekend"), SubResource("Plan_everyday")])
