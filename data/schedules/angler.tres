[gd_resource type="Resource" script_class="ScheduleDef" format=3]

[ext_resource type="Script" path="res://scripts/resources/schedule_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/resources/day_plan.gd" id="2_plan"]
[ext_resource type="Script" path="res://scripts/resources/schedule_stop.gd" id="3_stop"]
[ext_resource type="Resource" path="res://data/unlocks/tavern_opens.tres" id="4_unlock"]

[sub_resource type="Resource" id="Stop_saturday_1"]
script = ExtResource("3_stop")
at = 360
place = &"cove"
cell = Vector2i(9, 28)
words = "fishing off the end of the pier at the Cove"

[sub_resource type="Resource" id="Stop_saturday_2"]
script = ExtResource("3_stop")
at = 1080
place = &"wren_cottage"

[sub_resource type="Resource" id="Stop_saturday_3"]
script = ExtResource("3_stop")
at = 1140
place = &"tavern"
cell = Vector2i(8, 6)
words = "at a table in the Wheatsheaf"

[sub_resource type="Resource" id="Stop_saturday_4"]
script = ExtResource("3_stop")
at = 1320
place = &"wren_cottage"

[sub_resource type="Resource" id="Plan_saturday"]
script = ExtResource("2_plan")
weekdays = Array[int]([5])
requires_unlock = ExtResource("4_unlock")
stops = Array[ExtResource("3_stop")]([SubResource("Stop_saturday_1"), SubResource("Stop_saturday_2"), SubResource("Stop_saturday_3"), SubResource("Stop_saturday_4")])

