[gd_resource type="Resource" script_class="ScheduleDef" format=3]

[ext_resource type="Script" path="res://scripts/resources/schedule_def.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/resources/day_plan.gd" id="2_plan"]
[ext_resource type="Script" path="res://scripts/resources/schedule_stop.gd" id="3_stop"]

[sub_resource type="Resource" id="Stop_sunday_1"]
script = ExtResource("3_stop")
at = 360
place = &"bakery"
words = "behind the counter at the bakery"

[sub_resource type="Resource" id="Stop_sunday_2"]
script = ExtResource("3_stop")
at = 840
place = &"cove"
cell = Vector2i(30, 22)
words = "walking on the beach at the Cove"

[sub_resource type="Resource" id="Stop_sunday_3"]
script = ExtResource("3_stop")
at = 1080
place = &"bakery"

[sub_resource type="Resource" id="Plan_sunday"]
script = ExtResource("2_plan")
weekdays = Array[int]([6])
stops = Array[ExtResource("3_stop")]([SubResource("Stop_sunday_1"), SubResource("Stop_sunday_2"), SubResource("Stop_sunday_3")])

[sub_resource type="Resource" id="Stop_everyday_1"]
script = ExtResource("3_stop")
at = 360
place = &"bakery"
words = "behind the counter at the bakery"

[sub_resource type="Resource" id="Stop_everyday_2"]
script = ExtResource("3_stop")
at = 840
place = &"town"
cell = Vector2i(12, 16)
words = "by the garden in town"

[sub_resource type="Resource" id="Stop_everyday_3"]
script = ExtResource("3_stop")
at = 1020
place = &"town"
cell = Vector2i(24, 20)
words = "in the town square"

[sub_resource type="Resource" id="Stop_everyday_4"]
script = ExtResource("3_stop")
at = 1140
place = &"bakery"

[sub_resource type="Resource" id="Plan_everyday"]
script = ExtResource("2_plan")
stops = Array[ExtResource("3_stop")]([SubResource("Stop_everyday_1"), SubResource("Stop_everyday_2"), SubResource("Stop_everyday_3"), SubResource("Stop_everyday_4")])

[resource]
script = ExtResource("1_def")
home = &"bakery"
home_words = "at home over the bakery"
plans = Array[ExtResource("2_plan")]([SubResource("Plan_sunday"), SubResource("Plan_everyday")])
