at = 720
place = &"town"
cell = Vector2i(21, 20)
words = "in the town square"

[sub_resource type="Resource" id="Stop_everyday_3"]
script = ExtResource("3_stop")
at = 840
place = &"tavern"
words = "getting the Wheatsheaf ready (it opens at 4 PM)"

[sub_resource type="Resource" id="Stop_everyday_4"]
script = ExtResource("3_stop")
at = 960
place = &"tavern"
words = "behind the bar at the Wheatsheaf"

[sub_resource type="Resource" id="Plan_everyday"]
script = ExtResource("2_plan")
stops = Array[ExtResource("3_stop")]([SubResource("Stop_everyday_1"), SubResource("Stop_everyday_2"), SubResource("Stop_everyday_3"), SubResource("Stop_everyday_4")])

[resource]
script = ExtResource("1_def")
home = &"tavern"
home_words = "upstairs at the Wheatsheaf"
plans = Array[ExtResource("2_plan")]([SubResource("Plan_sunday"), SubResource("Plan_everyday")])
