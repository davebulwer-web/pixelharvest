weed_chance_grass = 0.02
most_new_weeds = 8
weed_item = ExtResource("4_fibre")
pull_weeds_energy = 1.0
untill_chance = 0.05
crows_start = ExtResource("3_crows")
crow_safe_crops = 16
crow_chance = 0.75
crows_most_taken = 2
