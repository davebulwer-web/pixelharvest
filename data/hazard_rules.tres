[gd_resource type="Resource" script_class="HazardRules" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/hazard_rules.gd" id="1_rules"]
[ext_resource type="Resource" path="res://data/unlocks/weeds_arrive.tres" id="2_weeds"]
[ext_resource type="Resource" path="res://data/unlocks/crows_arrive.tres" id="3_crows"]
[ext_resource type="Resource" path="res://data/produce/fibre.tres" id="4_fibre"]

[resource]
script = ExtResource("1_rules")
wilt_after_dry_nights = 2
die_after_dry_nights = 3
weeds_start = ExtResource("2_weeds")
