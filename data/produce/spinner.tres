[gd_resource type="Resource" script_class="LureDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/resources/lure_def.gd" id="1_lure"]
[ext_resource type="Texture2D" path="res://assets/sprites/items/spinner.png" id="2_icon"]

[resource]
script = ExtResource("1_lure")
id = &"spinner"
display_name = "Pip's spinner"
description = "A shiny spinner Pip found in the reeds. Kept in the bag, never used up: from spring to autumn fish bite a little sooner, and your bait stays in its tin."
icon = ExtResource("2_icon")
seasons = Array[StringName]([&"spring", &"summer", &"autumn"])
wait_multiplier = 0.75
