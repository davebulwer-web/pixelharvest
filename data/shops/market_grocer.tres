[resource]
script = ExtResource("1_shop")
id = &"market_grocer"
display_name = "Rosa's Produce Stall"
keeper_name = "Rosa"
keeper_sprite = ExtResource("2_keeper")
greetings = Array[String](["Fresh from your field? I pay more than any bin, and I pay today.", "Market day's the best day of the week. Bring me everything you've got!", "The city folk can't get enough of good country vegetables."])
buys_produce = true
produce_pay_rate = 1.25
opens_at = 480
closes_at = 840
