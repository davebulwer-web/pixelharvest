[resource]
script = ExtResource("1_shop")
id = &"general_store"
display_name = "Marlow's General Store"
keeper_name = "Marlow"
keeper_sprite = ExtResource("2_keeper")
keeper_portrait = ExtResource("80_portrait")
greetings = Array[String](["[happy] Welcome in! I'll buy your produce, and sell you a bit of land or a hearty breakfast.", "Bring me fresh vegetables and I'll pay you now. The shipping bin pays more, but it pays tomorrow.", "Looking to farm a bigger patch? Ask me about the fields.", "A farm should look loved. I've fences, flower beds and lamps, and a scarecrow or two.", "Twenty of anything I can shift at the going rate. After that it's stacked to the ceiling and I pay what I can. Tomorrow's another day."])
sells_decorations = true
upgrade_categories = Array[StringName]([&"energy", &"land"])
buys_produce = true
demand = SubResource("Demand_plenty")
opens_at = 480
closes_at = 1200
