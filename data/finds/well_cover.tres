[gd_resource type="Resource" script_class="FindDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/find_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"well_cover"
display_name = "The cover of a buried well"
found_under = Array[StringName]([&"stones", &"bramble"])
chance = 0.05
times = 1
first_day = 5
words = Array[String](["Under it, a round wooden lid, banded with iron: the cover of an old well, buried for years.", "Lift a corner and you can hear water, far down. You put the cover back. The well stays where it is."])
leaves_object = &"old_well"
