[resource]
script = ExtResource("1_def")
id = &"angler"
display_name = "Wren"
sprite = ExtResource("2_sprite")
portrait = ExtResource("80_portrait")
walk_frames = ExtResource("81_walk")
location = &"town"
lines = Array[String](["[worried] Shh. You'll scare the fish.", "Tench in the early morning, barbel at dusk, eels after dark. Every fish keeps its own hours.", "[happy] Your farm's got a pond too, hasn't it? Lucky.", "The river has its own fish, chub and dace and the like. The Woods' stream has trout.", "Sprinklers, eh? In my day we carried every drop.", "When the rain swells the stream, the sea trout come up. Silver, and strong with it.", "Ice on the pond? Cut a hole and be patient. Perch and pike don't mind the cold.", "Contest's on the fourteenth of summer, at the town pond. Biggest fish I ever saw there was a carp as long as your leg."])
schedule = ExtResource("20_schedule")
