[resource]
script = ExtResource("1_def")
id = &"ivy"
display_name = "Ivy"
sprite = ExtResource("2_sprite")
portrait = ExtResource("80_portrait")
walk_frames = ExtResource("81_walk")
location = &"town"
lines = Array[String](["This glasshouse grew oranges once. Oranges! In this valley.", "Perennials are the patient gardener's friend. Plant once, pick for years.", "[happy] The old farm fed the whole valley when I was young. It's good to see it working again.", "A flower among the vegetables keeps the aphids honest. My mother taught me that.", "[worried] Mind the frost at the end of autumn, dear. The tender ones won't forgive you.", "Bees love a flower bed. Put a hive near flowers and they'll give you twice the honey."])
requires_unlock = ExtResource("3_unlock")
schedule = ExtResource("20_schedule")
