[resource]
script = ExtResource("1_def")
id = &"nell"
display_name = "Nell"
sprite = ExtResource("2_sprite")
location = &"town"
lines = Array[String](["Doors open at four, last orders at one. In between, the Wheatsheaf's the warmest room in the valley.", "I buy a bit of what I need off the chalkboard every day. Read it before you sell the lot to Marlow.", "A tavern hears everything. Where the fish are, what the weather's doing, who's after what. Ask me at the bar.", "Friday's darts night. The mayor fancies himself, and Wren's better than he lets on.", "My mother kept the Wheatsheaf, and her father before her. It's been shut ten years. Not any more."])
requires_unlock = ExtResource("9_unlock")
schedule = ExtResource("20_schedule")
