[gd_resource type="Resource" script_class="CharacterDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/resources/character_def.gd" id="1_def"]
[ext_resource type="Texture2D" path="res://assets/sprites/lane/dot.png" id="2_sprite"]

[resource]
script = ExtResource("1_def")
id = &"dot"
display_name = "Dot"
sprite = ExtResource("2_sprite")
location = &"lane"
spots = Array[Vector2i]([Vector2i(46, 15)])
lines = Array[String](["Everything in this valley comes past my gate sooner or later. Parcels, gossip, weather.", "My cart's got one wheel that squeaks and one that sulks. Like most horses I've known.", "If it's got an address, I'll carry it. If it hasn't, I'll find out who it's for.", "The Lane's the only road between your farm and town. You'll be seeing a lot of me.", "Mind the ford after rain. It's deeper than it looks, and colder than that."])
