[gd_resource type="Resource" script_class="CharacterDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/resources/character_def.gd" id="1_def"]
[ext_resource type="Texture2D" path="res://assets/sprites/town/mayor.png" id="2_sprite"]

[resource]
script = ExtResource("1_def")
id = &"mayor"
display_name = "Mayor Bramble"
sprite = ExtResource("2_sprite")
location = &"town"
spots = Array[Vector2i]([Vector2i(22, 16), Vector2i(20, 21), Vector2i(16, 16)])
lines = Array[String](["Welcome to town, farmer! It's good to see that old farm worked again.", "Read the notice board now and then. It knows the calendar better than I do.", "Marlow at the general store will buy your vegetables on the spot. The bin pays better, if you can wait a night.", "When a season turns, anything that can't grow in the new one is lost. Plan ahead!", "The blacksmith can make your tools reach further. Worth saving up for.", "I sit by this fountain every day. Best seat in town.", "There was a bridge to the woods once, before the flood took it. One day we'll put it back."])
