; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pixel Harvest"
config/description="A top-down pixel-art farming game."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
InputActions="*res://scripts/autoload/input_actions.gd"
ContentDB="*res://scripts/autoload/content_db.gd"
GameState="*res://scripts/autoload/game_state.gd"
Economy="*res://scripts/autoload/economy.gd"
TimeSystem="*res://scripts/autoload/time_system.gd"
Quests="*res://scripts/autoload/quests.gd"
Allotments="*res://scripts/autoload/allotments.gd"
LocationManager="*res://scripts/autoload/location_manager.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Audio="*res://scripts/autoload/audio.gd"
DayReport="*res://scripts/autoload/day_report.gd"
Fishing="*res://scripts/autoload/fishing.gd"
Festivals="*res://scripts/autoload/festivals.gd"
Tavern="*res://scripts/autoload/tavern.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui/theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
